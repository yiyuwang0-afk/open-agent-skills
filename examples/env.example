# Copy this file to your local Obsidian vault as `.env`.
# Do not commit your real `.env`.

# OpenAI-compatible classifier API.
# Examples:
# - OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com
# - Local gateway: http://127.0.0.1:8000/v1
CLASSIFIER_API_KEY=
CLASSIFIER_BASE_URL=https://api.openai.com/v1
CLASSIFIER_MODEL=gpt-4.1-mini

# Optional Feishu/Lark bot credentials for obsidian-knowledge-flow/scripts/feishu_receiver.py.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
